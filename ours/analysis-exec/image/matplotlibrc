# Figures are shown on the result card over a light or a dark page, so the
# background is transparent and text, axes and grid use one mid gray that reads
# on both. Scripts set data, labels and titles only.
backend: Agg
font.family: NanumGothic, DejaVu Sans
font.size: 11
axes.unicode_minus: False
figure.figsize: 8, 4.2
figure.dpi: 110
savefig.dpi: 160
savefig.bbox: tight
savefig.transparent: True
figure.facecolor: none
axes.facecolor: none
text.color: 868e96
axes.labelcolor: 868e96
axes.edgecolor: 868e96
axes.titlecolor: 868e96
axes.titlesize: 13
xtick.color: 868e96
ytick.color: 868e96
axes.spines.top: False
axes.spines.right: False
axes.grid: True
axes.grid.axis: y
grid.color: 868e96
grid.alpha: 0.25
legend.frameon: False
lines.linewidth: 2
lines.markersize: 6
axes.prop_cycle: cycler('color', ['4c6ef5', 'f08c00', '2f9e44', 'e03131', '7048e8', '1098ad'])
