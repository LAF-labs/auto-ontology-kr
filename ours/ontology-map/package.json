{
  "name": "@ours/ontology-map",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only data map: the business terms of the connected Auto-ontology catalog and their links, drawn as a graph in a sidebar panel. Host routes read the gateway with the read token; no model.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src/*.js",
    "locale/*.json",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
