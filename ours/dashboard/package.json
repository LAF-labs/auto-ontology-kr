{
  "name": "@ours/dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Dashboards as specs: host store (versions, drafts, publish pointer, widget modules), /api/dashboard routes, and the browser runtime.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./http": "./http.js",
    "./client": "./client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "http.js", "client.js", "src/*.js", "cordis.patch.yml", "SPEC.md"],
  "scripts": {
    "test": "node --test tests/*.test.js"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
