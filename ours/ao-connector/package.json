{
  "name": "@ours/ao-connector",
  "version": "0.1.0",
  "private": true,
  "description": "Auto-ontology REST gateway client: saved analyses for dashboards, and term search, answerability and questions for agents.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./http": "./http.js",
    "./tools": "./tools.js",
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "http.js",
    "tools.js",
    "src/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "client.js"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  }
}
