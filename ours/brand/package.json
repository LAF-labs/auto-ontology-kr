{
  "name": "@ours/brand",
  "version": "0.1.0",
  "private": true,
  "description": "Product name and logo from configuration: window title, favicon, sidebar head, and the `productBrand` service other host packages read (the sign-in page).",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "client.js", "src/*.js", "cordis.patch.yml"],
  "scripts": {
    "test": "node --test tests/*.test.js"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar", "@deepseek-ai/dsh-client-locale"]
    }
  }
}
